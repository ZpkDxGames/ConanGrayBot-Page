    "generate": "openapi-typescript contracts/openapi.json -o src/lib/generated.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "jose": "6.1.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "openapi-typescript": "7.13.0",
    "@playwright/test": "1.58.2",
    "@axe-core/playwright": "4.11.1"
  }
}
